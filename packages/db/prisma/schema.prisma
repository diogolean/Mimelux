generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FAN
  CREATOR
  AFFILIATE
  MODERATOR
  ADMIN
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum PayoutMethod {
  PIX
  STRIPE
  CRYPTO
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
}

enum CreatorStatus {
  DRAFT
  PENDING
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELED
  EXPIRED
}

enum ContentVisibility {
  FREE
  SUBSCRIBERS
  PPV
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum PurchaseKind {
  SUBSCRIPTION
  POST
  MESSAGE
  PACK
  SPECIAL_REQUEST
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum SpecialRequestStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  PAID
  DELIVERED
  DECLINED
  REFUNDED
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  role             UserRole         @default(FAN)
  emailVerifiedAt  DateTime?
  refreshTokenHash String?
  isDemo           Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  creator          Creator?
  profile          Profile?
  subscriptions    Subscription[]   @relation("FanSubscriptions")
  purchases        Purchase[]       @relation("BuyerPurchases")
  messages         Message[]        @relation("SentMessages")
  ledgerEntries    LedgerEntry[]    @relation("UserLedger")
  reportsCreated   Report[]         @relation("Reporters")
  reportsReceived  Report[]         @relation("ReportedUsers")
  auditLogs        AuditLog[]       @relation("AuditActors")
  affiliate        Affiliate?
  attributions     Attribution[]    @relation("AttributedFans")
  specialRequests  SpecialRequest[] @relation("FanSpecialRequests")

  @@map("users")
}

model Creator {
  id                   String           @id @default(cuid())
  userId               String           @unique
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               CreatorStatus    @default(DRAFT)
  category             String
  aiGenerated          Boolean          @default(false)
  fictitious           Boolean          @default(false)
  acceptsAffiliates    Boolean          @default(true)
  commissionBps        Int              @default(2000)
  commissionOnPpv      Boolean          @default(true)
  commissionOnPacks    Boolean          @default(true)
  commissionOnRequests Boolean          @default(true)
  isDemo               Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  plans                Plan[]
  subscriptions        Subscription[]
  posts                Post[]
  purchases            Purchase[]
  ledgerEntries        LedgerEntry[]
  affiliateLinks       AffiliateLink[]
  promotions           Promotion[]
  contentPacks         ContentPack[]
  specialRequests      SpecialRequest[]

  @@map("creators")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  username  String   @unique
  bio       String?
  city      String?
  avatarUrl String?
  coverUrl  String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model Plan {
  id              String         @id @default(cuid())
  creatorId       String
  creator         Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name            String
  description     String
  priceCents      Int
  durationMonths  Int            @default(1)
  discountPercent Int            @default(0)
  active          Boolean        @default(true)
  isDemo          Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
  promotions      Promotion[]

  @@index([creatorId])
  @@map("plans")
}

model Subscription {
  id        String             @id @default(cuid())
  fanId     String
  fan       User               @relation("FanSubscriptions", fields: [fanId], references: [id], onDelete: Cascade)
  creatorId String
  creator   Creator            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(PENDING)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  isDemo    Boolean            @default(false)

  @@unique([fanId, creatorId])
  @@index([creatorId, status])
  @@map("subscriptions")
}

model Post {
  id          String            @id @default(cuid())
  creatorId   String
  creator     Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  caption     String
  visibility  ContentVisibility @default(FREE)
  priceCents  Int?
  isDemo      Boolean           @default(false)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  media       Media[]
  purchases   Purchase[]
  reports     Report[]
  packItems   ContentPackItem[]

  @@index([creatorId, publishedAt])
  @@map("posts")
}

model Media {
  id         String    @id @default(cuid())
  postId     String?
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  messageId  String?
  message    Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind       MediaKind
  storageKey String
  mimeType   String
  width      Int?
  height     Int?
  durationMs Int?
  isDemo     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([postId])
  @@index([messageId])
  @@map("media")
}

model Purchase {
  id             String          @id @default(cuid())
  buyerId        String
  buyer          User            @relation("BuyerPurchases", fields: [buyerId], references: [id])
  creatorId      String
  creator        Creator         @relation(fields: [creatorId], references: [id])
  postId         String?
  post           Post?           @relation(fields: [postId], references: [id])
  messageId      String?
  message        Message?        @relation(fields: [messageId], references: [id])
  contentPackId  String?
  contentPack    ContentPack?    @relation(fields: [contentPackId], references: [id])
  kind           PurchaseKind
  status         PurchaseStatus  @default(PENDING)
  amountCents    Int
  currency       String          @default("BRL")
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  isDemo         Boolean         @default(false)
  ledgerEntries  LedgerEntry[]
  paymentEvents  PaymentEvent[]
  conversion     Conversion?
  specialRequest SpecialRequest?

  @@index([buyerId, status])
  @@index([creatorId, status])
  @@map("purchases")
}

model Conversation {
  id             String    @id @default(cuid())
  participantIds Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  isDemo         Boolean   @default(false)
  messages       Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  body           String
  ppvPriceCents  Int?
  isDemo         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  media          Media[]
  purchases      Purchase[]
  reports        Report[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model LedgerEntry {
  id          String          @id @default(cuid())
  userId      String?
  user        User?           @relation("UserLedger", fields: [userId], references: [id])
  creatorId   String?
  creator     Creator?        @relation(fields: [creatorId], references: [id])
  purchaseId  String?
  purchase    Purchase?       @relation(fields: [purchaseId], references: [id])
  direction   LedgerDirection
  account     String
  amountCents Int
  currency    String          @default("BRL")
  reference   String
  createdAt   DateTime        @default(now())

  @@index([purchaseId])
  @@index([creatorId, createdAt])
  @@map("ledger_entries")
}

model PaymentEvent {
  id          String    @id @default(cuid())
  provider    String
  providerId  String
  purchaseId  String?
  purchase    Purchase? @relation(fields: [purchaseId], references: [id])
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, providerId])
  @@index([purchaseId])
  @@map("payment_events")
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reporter     User         @relation("Reporters", fields: [reporterId], references: [id])
  targetUserId String?
  targetUser   User?        @relation("ReportedUsers", fields: [targetUserId], references: [id])
  postId       String?
  post         Post?        @relation(fields: [postId], references: [id])
  messageId    String?
  message      Message?     @relation(fields: [messageId], references: [id])
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])
  @@map("reports")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActors", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  ipHash     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Promotion {
  id              String   @id @default(cuid())
  creatorId       String
  creator         Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  planId          String?
  plan            Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  name            String
  discountPercent Int
  startsAt        DateTime
  endsAt          DateTime
  subscriberCap   Int?
  redeemedCount   Int      @default(0)
  active          Boolean  @default(true)
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([creatorId, startsAt, endsAt])
  @@map("promotions")
}

model ContentPack {
  id          String            @id @default(cuid())
  creatorId   String
  creator     Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name        String
  description String
  priceCents  Int
  active      Boolean           @default(true)
  isDemo      Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  items       ContentPackItem[]
  purchases   Purchase[]

  @@index([creatorId, active])
  @@map("content_packs")
}

model ContentPackItem {
  id     String      @id @default(cuid())
  packId String
  pack   ContentPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  postId String
  post   Post        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([packId, postId])
  @@map("content_pack_items")
}

model SpecialRequest {
  id                   String                  @id @default(cuid())
  fanId                String
  fan                  User                    @relation("FanSpecialRequests", fields: [fanId], references: [id])
  creatorId            String
  creator              Creator                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  purchaseId           String?                 @unique
  purchase             Purchase?               @relation(fields: [purchaseId], references: [id])
  description          String
  requestedBudgetCents Int?
  quotedPriceCents     Int?
  status               SpecialRequestStatus    @default(REQUESTED)
  deliveryUrl          String?
  isDemo               Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  messages             SpecialRequestMessage[]

  @@index([creatorId, status])
  @@index([fanId, createdAt])
  @@map("special_requests")
}

model SpecialRequestMessage {
  id         String         @id @default(cuid())
  requestId  String
  request    SpecialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderRole UserRole
  body       String
  createdAt  DateTime       @default(now())

  @@index([requestId, createdAt])
  @@map("special_request_messages")
}

model Affiliate {
  id            String          @id @default(cuid())
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String          @unique
  displayName   String
  status        String          @default("ACTIVE")
  payoutMethod  PayoutMethod    @default(PIX)
  payoutDetails Json?
  isDemo        Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  links         AffiliateLink[]
  commissions   Commission[]
  payouts       Payout[]

  @@map("affiliates")
}

model AffiliateLink {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  slug        String
  active      Boolean   @default(true)
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  clicks      Click[]

  @@unique([affiliateId, creatorId])
  @@index([slug])
  @@map("affiliate_links")
}

model Click {
  id          String        @id @default(cuid())
  linkId      String
  link        AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  subId       String?
  locale      String?
  ipHash      String?
  userAgent   String?
  suspicious  Boolean       @default(false)
  isDemo      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  attribution Attribution?

  @@index([linkId, createdAt])
  @@map("clicks")
}

model Attribution {
  id            String       @id @default(cuid())
  clickId       String       @unique
  click         Click        @relation(fields: [clickId], references: [id], onDelete: Cascade)
  fanId         String?
  fan           User?        @relation("AttributedFans", fields: [fanId], references: [id])
  expiresAt     DateTime
  blockedReason String?
  isDemo        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  conversions   Conversion[]

  @@index([fanId])
  @@map("attributions")
}

model Conversion {
  id            String       @id @default(cuid())
  attributionId String
  attribution   Attribution  @relation(fields: [attributionId], references: [id], onDelete: Cascade)
  purchaseId    String?      @unique
  purchase      Purchase?    @relation(fields: [purchaseId], references: [id])
  kind          String
  amountCents   Int
  currency      String       @default("BRL")
  isDemo        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  commissions   Commission[]

  @@index([attributionId])
  @@map("conversions")
}

model Commission {
  id           String           @id @default(cuid())
  affiliateId  String
  affiliate    Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  conversionId String
  conversion   Conversion       @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  payoutId     String?
  payout       Payout?          @relation(fields: [payoutId], references: [id])
  rateBps      Int
  amountCents  Int
  currency     String           @default("BRL")
  status       CommissionStatus @default(PENDING)
  holdUntil    DateTime
  renewalUntil DateTime
  isDemo       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([affiliateId, status])
  @@map("commissions")
}

model Payout {
  id          String       @id @default(cuid())
  affiliateId String
  affiliate   Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  method      PayoutMethod
  amountCents Int
  currency    String       @default("BRL")
  status      PayoutStatus @default(REQUESTED)
  isDemo      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  commissions Commission[]

  @@index([affiliateId, status])
  @@map("payouts")
}
